class Be < Formula
  desc "Turn complex shell commands into simple tags"
  homepage "https://github.com/ji233-Sun/beaver"
  version "${VERSION}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/ji233-Sun/beaver/releases/download/v${VERSION}/be-aarch64-apple-darwin.tar.gz"
      sha256 "${SHA_ARM64}"
    else
      url "https://github.com/ji233-Sun/beaver/releases/download/v${VERSION}/be-x86_64-apple-darwin.tar.gz"
      sha256 "${SHA_X86_64}"
    end
  end

  on_linux do
    url "https://github.com/ji233-Sun/beaver/releases/download/v${VERSION}/be-x86_64-unknown-linux-gnu.tar.gz"
    sha256 "${SHA_LINUX}"
  end

  def install
    bin.install "be"
  end

  test do
    assert_match "be", shell_output("#{bin}/be --help")
  end
end
